# DeepSeek API credentials (copy to .env or export in your shell; NEVER commit the real key)
export OPENAI_API_KEY=sk-your-deepseek-key-here
export OPENAI_BASE_URL=https://api.deepseek.com
# HuggingFace mirror (only needed if huggingface.co is unreachable from your network)
export HF_ENDPOINT=https://hf-mirror.com
